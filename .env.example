# Zugang zum Supabase-Projekt (NB-02 Auth, NB-03 PostgREST).
#
# Fuer die lokale Entwicklung als .env.local kopieren und den Schluessel
# einsetzen. Beide Werte sind oeffentlich - der Schluessel liegt im
# Browser-Bundle und ist laut S1.1 kein Geheimnis; die Autorisierung leistet
# Row-Level-Security auf Datenbankebene (N2.2), nicht der Schluessel.
#
# Der geheime Service-Role-Key wird vom Frontend NIE verwendet und gehoert
# weder hierhin noch in die Vercel-Clientvariablen (A07).
#
# Den Publishable Key findet ihr im Supabase-Dashboard unter
# Project Settings -> API Keys.

VITE_SUPABASE_URL=https://uqpjctqedenmjonkqubq.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
