@startuml A06-session-und-court-erstellen
skinparam backgroundColor White
skinparam shadowing false
skinparam ArrowColor Black
skinparam ArrowFontSize 11
skinparam sequence {
  LifelineBorderColor Black
  ParticipantBorderColor Black
  ParticipantBackgroundColor White
  ActorBorderColor Black
  ActorBackgroundColor White
}

actor Organisator
participant "DLG-05\nCreateSessionPage" as Create
participant "CourtLocationPicker" as Map
participant "geocodingService" as Geo
participant "courtService" as CourtSvc
participant "sessionService" as Service
participant "NB-04\nOpenStreetMap-Tiles" as OSM
participant "NB-05\nNominatim" as Nominatim
participant "NB-03\nSupabase PostgREST" as API

Create -> CourtSvc : getCourts()
activate CourtSvc
CourtSvc -> API : vorhandene Courts lesen
API --> CourtSvc : Court-Liste
CourtSvc --> Create : Auswahlliste (UC-10)
deactivate CourtSvc

Organisator -> Create : Sportart, Titel, Zeit, Dauer,\nTeilnehmerlimit eingeben

opt neuer Court statt Auswahl (UC-10)
  Create -> Map : Kartenpin setzen
  Map -> OSM : Kacheln laden
  OSM --> Map : Kartenbilder
  Map --> Create : latitude, longitude
  Create -> Geo : reverseGeocode(lat, lon)
  Geo -> Nominatim : ortAufloesen
  Nominatim --> Geo : city, address?
  Geo --> Create : ermittelter Ort
  note right of Create
    Ohne verwertbaren Ort wird kein
    unvollständiger Court übernommen
    (UC-10 Ausnahmefall)
  end note
end

Create -> Service : createSession(payload mit court_id\n**oder** Court-Feldern)
activate Service
Service -> API : RPC create_session (JWT)
activate API
API -> API : Court (falls neu), Session mit PIN (AF-04)\nsowie organizer- und participant-Eintrag\natomar anlegen (ADR-001, N2.2, S1.4)
API --> Service : Session mit PIN
deactivate API
Service --> Create : Erfolg
deactivate Service

Create --> Organisator : DLG-04 (Organisator-Zustand)\nmit QR-Code/PIN

@enduml
