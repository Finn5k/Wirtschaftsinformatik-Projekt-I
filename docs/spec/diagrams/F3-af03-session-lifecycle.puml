@startuml F3-af03-session-lifecycle
skinparam backgroundColor White
skinparam state {
  BackgroundColor White
  BorderColor Black
}
skinparam ArrowColor Black

[*] --> scheduled : Session erstellt
scheduled --> active : jetzt erreicht Start
active --> completed : jetzt erreicht Start + Dauer
completed --> [*]

note right of scheduled : Beitritt möglich, kein Check-in
note right of active : Beitritt und Check-in möglich
note right of completed : nur Historie (read-only), Endzustand

note "Status wird bei jeder Abfrage aus Start,\nDauer und aktueller Zeit berechnet –\nnicht persistiert, kein manueller Wechsel (N2.6)" as N
@enduml
